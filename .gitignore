# ─── Node.js dependencies (always reinstalled via npm install) ───
node_modules/

# ─── Frontend build output (generated by npm run build) ───
frontend/dist/

# ─── Backend runtime data (private – DO NOT upload) ───
backend/data/
backend/servers/

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment variables (secrets) ───
.env
.env.*

# ─── OS junk ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor folders ───
.vscode/
.idea/
